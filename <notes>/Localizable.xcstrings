{
  "sourceLanguage": "ru",
  "version": "1.0",
  "strings": {
    "\n\nУже скачано: %@. Можно надиктовывать ей прямо сейчас.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nAlready downloaded: %@. You can dictate with it right now."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nVeć preuzeto: %@. Možeš odmah da diktiraš s njim."
          }
        }
      }
    },
    " · скачано": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · downloaded"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": " · preuzeto"
          }
        }
      }
    },
    "%.1f гб": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f gb"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f gb"
          }
        }
      }
    },
    "%@ · %@ · расшифровано %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · transcribed %@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@ · transkribovano %@"
