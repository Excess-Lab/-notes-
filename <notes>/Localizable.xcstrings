      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ at %@"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ u %@"
          }
        }
