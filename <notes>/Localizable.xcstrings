            "state": "translated",
            "value": "%@, ceo dan"
          }
        }
      }
    },
    "%@: скачано %lld %%. Как закончится, надиктовка заработает сама.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld %% downloaded. Dictation will work once it's done."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: preuzeto %lld %%. Diktiranje će raditi kad se završi."
          }
        }
      }
    },
