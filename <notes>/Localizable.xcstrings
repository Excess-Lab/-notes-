    "iCloud синхронизирует историю git по частям и может её повредить. Лучше выбрать папку вне iCloud Drive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud syncs git history in pieces and can damage it. Better pick a folder outside iCloud Drive."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sinhronizuje git istoriju u delovima i može da je ošteti. Bolje izaberi folder van iCloud Drive."
          }
        }
      }
    },
    "Взять %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
