{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notes",
  "version": "0.1.0",
  "identifier": "ai.edinstvo.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "<notes>",
        "width": 1200,
        "height": 760,
        "minWidth": 820,
        "minHeight": 760,
        "decorations": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Plain Markdown notes with git history",
    "copyright": "© 2026 Makar K, MIT"
  }
}